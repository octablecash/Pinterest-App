# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die .env wird NICHT committet (siehe .gitignore).

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8080/callback

# Werden von "python -m moodloft login" automatisch eingetragen:
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=

# Optional: Standard-Board für neue Pins (ID aus "python -m moodloft boards")
PINTEREST_BOARD_ID=

# Optional: Sandbox statt Produktion
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5
